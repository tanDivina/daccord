# PayPal REST app (developer.paypal.com > Apps & Credentials, Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Webhook ID from the same app, for /api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# Claude grades criteria, disputes and drafts contracts
ANTHROPIC_API_KEY=

# Signs payout attestations. Required in production: openssl rand -hex 32
DACCORD_SIGNING_SECRET=

# Optional: raises GitHub API rate limits for reading PRs
GITHUB_TOKEN=

# Datastore for the 48-hour review window and retry limits (Upstash Redis,
# e.g. via Vercel Storage). Either naming works. Without it, a Vercel
# production deployment pays out right after verification.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/release (Vercel sends it as a Bearer token): openssl rand -hex 24
CRON_SECRET=
